{
  "id": "npm",
  "name": "NPM",
  "patterns": [
    {
      "type": "NPM Access Token",
      "regex": "npm_[a-zA-Z0-9]{36}",
      "entropy": 4.5,
      "verify": {
        "type": "http",
        "method": "GET",
        "url": "https://registry.npmjs.org/-/whoami",
        "authType": "bearer",
        "redactAuth": true
      },
      "rotatonUrl": "https://www.npmjs.com/settings/tokens"
    },
    {
      "type": "NPM Automation Token",
      "regex": "npm_[a-zA-Z0-9]{36}",
      "entropy": 4.5,
      "verify": {
        "type": "http",
        "method": "GET",
        "url": "https://registry.npmjs.org/-/whoami",
        "authType": "bearer",
        "redactAuth": true
      }
    }
  ],
  "examples": [
    "npm_abc123def456ghi789jkl012mno345pq"
  ]
}